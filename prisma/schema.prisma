generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum Technique {
  chop
  mince
  slice
  season
  whisk
  fold
  knead
  marinate
  saute
  sear
  fry
  boil
  simmer
  drain
  roast
  bake
  broil
  rest
  chill
  plate

  @@map("technique")
}

enum Heat {
  low
  medium
  high

  @@map("heat")
}

enum TimerMode {
  stay
  background

  @@map("timer_mode")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  isAnonymous   Boolean  @default(false) @map("is_anonymous")
  username      String?  @unique
  name          String   @map("full_name")
  image         String?  @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  recipes         Recipe[]
  cookingSessions CookingSession[]
  favoriteRecipes FavoriteRecipe[]
  sessions        AuthSession[]
  accounts        Account[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Cuisine {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  recipes Recipe[]

  @@map("cuisines")
}

model Recipe {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  cuisineId   String?    @map("cuisine_id") @db.Uuid
  title       String
  description String?
  difficulty  Difficulty
  prepMinutes Int        @map("prep_minutes")
  cookMinutes Int        @map("cook_minutes")
  servings    Int
  imageUrl    String?    @map("image_url")
  sourceName  String?    @map("source_name")
  sourceUrl   String?    @map("source_url")
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user        User?              @relation(fields: [userId], references: [id])
  cuisine     Cuisine?           @relation(fields: [cuisineId], references: [id])
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  sessions    CookingSession[]
  favoritedBy FavoriteRecipe[]

  @@map("recipes")
}

model RecipeIngredient {
  id         String  @id @default(uuid()) @db.Uuid
  recipeId   String  @map("recipe_id") @db.Uuid
  position   Int
  name       String
  quantity   Float?
  unit       String?
  note       String?
  tokenShape String  @map("token_shape")
  tokenColor String  @map("token_color")

  recipe   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepUses StepIngredient[]

  @@index([recipeId, position])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  position     Int
  text         String
  technique    Technique
  heat         Heat?
  timerSeconds Int?       @map("timer_seconds")
  timerMode    TimerMode? @map("timer_mode")
  timerLabel   String?    @map("timer_label")
  cue          String?

  recipe      Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients StepIngredient[]

  @@index([recipeId, position])
  @@map("recipe_steps")
}

model StepIngredient {
  id           String  @id @default(uuid()) @db.Uuid
  stepId       String  @map("step_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  portion      Float   @default(1)
  note         String?

  step       RecipeStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  ingredient RecipeIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([ingredientId])
  @@map("step_ingredients")
}

model CookingSession {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  recipeId        String?     @map("recipe_id") @db.Uuid
  recipeSnapshot  Json        @map("recipe_snapshot")
  startedAt       DateTime    @map("started_at")
  finishedAt      DateTime?   @map("finished_at")
  durationSeconds Int?        @map("duration_seconds")
  techniques      Technique[]
  cuisineName     String?     @map("cuisine_name")
  difficulty      Difficulty?
  plausible       Boolean     @default(false)
  rating          Int?
  note            String?

  user   User?   @relation(fields: [userId], references: [id])
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  events SessionEvent[]

  @@index([userId, finishedAt])
  @@map("cooking_sessions")
}

model SessionEvent {
  id         String   @id @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  type       String
  stepIndex  Int?     @map("step_index")
  at         DateTime
  seq        Int      @default(0)
  payload    Json?
  receivedAt DateTime @default(now()) @map("received_at")

  session CookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at, seq])
  @@map("session_events")
}

model FavoriteRecipe {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@map("favorite_recipes")
}
