generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  username     String   @unique
  fullName     String?  @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  recipes         Recipe[]
  cookingSessions CookingSession[]
  favoriteRecipes FavoriteRecipe[]
}

model Cuisine {
  id      String   @id @default(uuid())
  name    String   @unique
  recipes Recipe[]
}

model Recipe {
  id               String   @id @default(uuid())
  userId           String
  cuisineId        String?
  title            String
  description      String?
  difficultyLevel  String?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  totalTimeMinutes Int?     @default(0)
  servings         Int?
  imageUrl         String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id])
  cuisine     Cuisine?           @relation(fields: [cuisineId], references: [id])
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  sessions    CookingSession[]
  favoritedBy FavoriteRecipe[]
}

model Ingredient {
  id             String    @id @default(uuid())
  name           String    @unique
  offFoodId      String?   @map("off_food_id")
  caloriesPer100 Float?    @map("calories_per_100g")
  proteinPer100  Float?    @map("protein_per_100g")
  carbsPer100    Float?    @map("carbs_per_100g")
  fatPer100      Float?    @map("fat_per_100g")
  updatedAt      DateTime? @map("updated_at")

  recipes RecipeIngredient[]
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  ingredientId String
  amount       Float?
  unit         String?
  order        Int
  notes        String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model RecipeStep {
  id              String  @id @default(uuid())
  recipeId        String
  stepNumber      Int
  instruction     String
  durationMinutes Int?
  imageUrl        String?

  recipe          Recipe                @relation(fields: [recipeId], references: [id])
  sessionProgress SessionStepProgress[]

  @@unique([recipeId, stepNumber])
}

model CookingSession {
  id               String    @id @default(uuid())
  userId           String
  recipeId         String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  totalTimeMinutes Int?
  difficultyRating Int?      @map("difficulty_rating")
  notes            String?

  user         User                  @relation(fields: [userId], references: [id])
  recipe       Recipe                @relation(fields: [recipeId], references: [id])
  stepProgress SessionStepProgress[]
}

model SessionStepProgress {
  id          String    @id @default(uuid())
  sessionId   String
  stepId      String
  completedAt DateTime?
  isCompleted Boolean   @default(false) @map("is_completed")

  session CookingSession @relation(fields: [sessionId], references: [id])
  step    RecipeStep     @relation(fields: [stepId], references: [id])

  @@unique([sessionId, stepId])
}

model FavoriteRecipe {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@unique([userId, recipeId])
}
